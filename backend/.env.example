# ============================================
# College Newsletter Backend Configuration
# ============================================

# App Settings
DEBUG=false
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-another-random-secret-key

# Database (Required)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/newsletter

# Redis (Optional but recommended)
REDIS_URL=redis://localhost:6379/0

# ============================================
# AI SERVICES - Choose ONE (or leave empty for free default)
# ============================================

# OPTION 1: Pollinations AI (DEFAULT)
# ✅ Completely FREE
# ✅ No signup required
# ✅ Works immediately
# Just leave all keys empty below

# OPTION 2: Groq (Recommended for speed)
# ⚡ FREE tier (20 req/min, 1M tokens/day)
# Get API key: https://console.groq.com/
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# OPTION 3: Hugging Face
# FREE inference API
# Get token: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=

# OPTION 4: OpenAI (Best quality, paid)
# Get API key: https://platform.openai.com/
# OPENAI_API_KEY=

# OPTION 5: Ollama (Local, requires installation)
# Install: https://ollama.com/
# USE_LOCAL_AI=false
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ============================================
# OPTIONAL SERVICES
# ============================================

# Email (SendGrid) - for newsletter delivery
# Get API key: https://app.sendgrid.com/
# SENDGRID_API_KEY=
FROM_EMAIL=newsletter@example.com

# Discord - for breaking news notifications
# Create webhook in Discord server settings
# DISCORD_WEBHOOK_URL=

# Twitter/X scraper (bird CLI credentials)
# Option A: Explicit bird vars
# BIRD_AUTH_TOKEN=
# BIRD_CT0=
#
# Option B: bird default names
# AUTH_TOKEN=
# CT0=
#
# Optional browser profile-based extraction
# BIRD_CHROME_PROFILE=Default
# BIRD_FIREFOX_PROFILE=default-release

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./data/storage

# AWS S3 (optional, for production)
# STORAGE_TYPE=s3
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=college-newsletter
# STORAGE_REGION=us-east-1

# ============================================
# CORS - Add your frontend URLs
# ============================================
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:5500"]

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
