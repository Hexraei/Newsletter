# =============================================================
# NEWS DAY — Environment Configuration
# =============================================================
# Copy this to .env and fill in your values
# Required vars for production marked with [REQUIRED]

# Environment: development | staging | production
ENVIRONMENT=development

# [REQUIRED in production] Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=jwt-secret-key-change-in-production

# Database (SQLite for dev, PostgreSQL for production)
# [REQUIRED in production] e.g., postgresql+asyncpg://user:pass@host:5432/newsletter
# Neon Cloud (direct, for migrations): postgresql+asyncpg://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Neon Cloud (pooled, for app/render):  postgresql+asyncpg://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///newsletter.db

# CORS origins (JSON array or comma-separated)
# [REQUIRED in production] e.g., ["https://newsday.yourdomain.com"]
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Cookie settings
COOKIE_DOMAIN=  # Empty for localhost; set to ".yourdomain.com" for production
COOKIE_SECURE=false  # Set to true in production (HTTPS)
COOKIE_SAMESITE=lax

# Redis (optional for dev, recommended for production)
REDIS_URL=redis://localhost:6379/0

# ============================================
# AI SERVICES - Choose ONE (or leave empty for free default)
# ============================================

# OPTION 1: Pollinations AI (DEFAULT)
# ✅ Completely FREE
# ✅ No signup required
# ✅ Works immediately
# Just leave all keys empty below

# OPTION 2: Groq (Recommended for speed)
# ⚡ FREE tier (20 req/min, 1M tokens/day)
# Get API key: https://console.groq.com/
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant

# OPTION 3: Hugging Face
# FREE inference API
# Get token: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=

# OPTION 4: OpenAI (Best quality, paid)
# Get API key: https://platform.openai.com/
# OPENAI_API_KEY=

# OPTION 5: Ollama (Local, requires installation)
# Install: https://ollama.com/
# USE_LOCAL_AI=false
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# ============================================
# OPTIONAL SERVICES
# ============================================

# Email (SendGrid) - for newsletter delivery / password reset
# Get API key: https://app.sendgrid.com/
# SENDGRID_API_KEY=
FROM_EMAIL=newsletter@example.com

# Discord - for breaking news notifications
# Create webhook in Discord server settings
# DISCORD_WEBHOOK_URL=

# Supabase (optional, lightweight feed storage/cache)
# Never commit real keys. Keep service key backend-only.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SCRAPED_TABLE=scraped_items
# SUPABASE_RANKED_CACHE_TABLE=ranked_sections_cache
# SUPABASE_CACHE_KEY=lite-all-sections
# SUPABASE_CACHE_TTL_MINUTES=15
# SUPABASE_FETCH_LIMIT=400

# Twitter/X scraper (bird CLI credentials)
# Option A: Explicit bird vars
# BIRD_AUTH_TOKEN=
# BIRD_CT0=
#
# Option B: bird default names
# AUTH_TOKEN=
# CT0=
#
# Optional browser profile-based extraction
# BIRD_CHROME_PROFILE=Default
# BIRD_FIREFOX_PROFILE=default-release

# File Storage
STORAGE_TYPE=local
STORAGE_PATH=./data/storage

# AWS S3 (optional, for production)
# STORAGE_TYPE=s3
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=college-newsletter
# STORAGE_REGION=us-east-1

# ============================================
# IMAGE APIs (Unsplash-first, then fallback providers)
# ============================================
# Unsplash — https://unsplash.com/developers
# UNSPLASH_ACCESS_KEY=
# Optional safety cap used by scrapers/fetch_images.py
# UNSPLASH_HOURLY_LIMIT=4800

# Pexels — https://www.pexels.com/api/ (free, 200 req/hr)
# PEXELS_API_KEY=

# Openverse is used automatically as last resort (free, no key needed)

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FORMAT=text  # text for dev, json for production

# Debug mode (auto-detected from ENVIRONMENT if not set)
DEBUG=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Strict-mode supplement and diversity controls (tuned for low-volume departments)
RELEVANCE_STRICT_SUPPLEMENT_ENABLED=true
RELEVANCE_STRICT_SUPPLEMENT_MAX_ITEMS=2
RELEVANCE_STRICT_SUPPLEMENT_MIN_ATTRACTIVENESS=35
RELEVANCE_SOURCE_DIVERSITY_CAP=2

# Relevance strict-mode controls
# Keep prefilter enabled to reject obvious low-signal items before expensive AI processing.
RELEVANCE_PREFILTER_ENABLED=true
# Cap Reddit intake in india_strict mode to reduce noisy flood.
RELEVANCE_REDDIT_MAX_PER_SUBREDDIT=8
RELEVANCE_REDDIT_MAX_TOTAL_ITEMS=60
